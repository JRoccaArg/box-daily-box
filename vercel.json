{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.boxdailybox.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "boxdailybox.com"
        }
      ]
    },
    {
      "source": "/juego/:gameId",
      "destination": "/es/juego/:gameId",
      "permanent": true
    },
    {
      "source": "/juegos/:gameId",
      "destination": "/es/juego/:gameId",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:lang/duelo/:duelId",
      "destination": "/:lang"
    }
  ]
}
